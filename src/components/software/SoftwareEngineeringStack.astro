        </div>
      </div>
      <div class="flex gap-4 items-start p-4">
        <svg class="h-6 w-6 text-primary shrink-0 mt-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
