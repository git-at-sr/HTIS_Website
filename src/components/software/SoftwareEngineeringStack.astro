---
import { Image } from 'astro:assets';
import CmsRichText from '~/components/CmsRichText.astro';
import type { SoftwareEngineeringStackSection } from '~/data/cms';

type Props = SoftwareEngineeringStackSection;

const { sectionId, backgroundImage, heading, description, cards } = Astro.props as Props;
---

<section
  id={sectionId}
  class="relative overflow-hidden border-t border-base-content/10 bg-base-100 py-24"
>
  <!-- Background Image with mix-blend-mode / luminosity masking -->
  <div class="pointer-events-none absolute inset-0 z-0 opacity-50">
    <Image
      src={backgroundImage}
      alt=""
      aria-hidden="true"
      class="h-full w-full object-cover object-center"
      style="filter: var(--filter-invert-dark)"
    />
    <!-- <div
      class="absolute inset-0 bg-linear-to-b from-base-100/90 via-transparent to-base-100"
    >
    </div> -->
  </div>

  <div class="relative z-10 container mx-auto px-6">
    <!-- Header -->
    <div class="mb-12 max-w-3xl text-left">
      <!-- <span class="text-xs uppercase tracking-wider font-bold text-primary mb-2 block">
        Engineering Excellence
      </span> -->
      <CmsRichText
        value={heading}
        tag="h2"
        className="mb-6 text-4xl font-extrabold tracking-tight whitespace-pre-line text-base-content md:text-5xl"
      />
      <CmsRichText
        value={description}
        tag="p"
        className="text-lg font-medium text-base-content/70"
      />
    </div>

    <!-- 6-card grid - 3 columns on desktop -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
      {
        cards.map((card) => (
          <div class="group relative flex min-h-[300px] flex-col items-stretch justify-between overflow-hidden rounded-2xl border border-base-content/12 bg-base-100/10 shadow-md backdrop-blur-lg transition-all duration-500 hover:-translate-y-1 hover:border-primary/20 hover:shadow-xl xl:grid xl:grid-cols-12">
            {/* Soft decorative background glow inside card */}
            <div class="absolute -right-12 -bottom-12 z-0 h-48 w-48 rounded-full bg-primary/5 blur-3xl transition-all duration-500 group-hover:bg-primary/8" />

            {/* Showcase Image: Top on mobile/tablet, right side on desktop (xl) */}
            <div class="relative flex h-[220px] items-end justify-center self-stretch overflow-hidden xl:col-span-5 xl:col-start-8 xl:row-start-2 xl:h-auto xl:min-h-auto xl:w-full">
              {/* Inner soft radial gradient behind image */}
              <div class="pointer-events-none absolute inset-0 z-0 bg-radial from-primary/10 via-transparent to-transparent opacity-65" />

              <div class="relative z-10 flex h-full w-full items-end justify-center px-6">
                <Image
                  src={card.image}
                  alt={card.alt}
                  class="h-full w-auto max-w-[240px] object-contain object-bottom transition-transform duration-500 group-hover:scale-105 xl:absolute xl:-right-4 xl:-bottom-4 xl:h-[105%] xl:w-auto xl:max-w-none"
                />
              </div>
            </div>

            {/* Title Section (Full Width on desktop) */}
            <div class="z-10 p-8 pt-6 pb-0 xl:col-span-12 xl:row-start-1 xl:p-10 xl:pb-0">
              <CmsRichText
                value={card.title}
                tag="h3"
                className="text-2xl font-medium tracking-tight text-base-content transition-colors duration-300 group-hover:text-primary"
              />
            </div>

            {/* Description (Left side on desktop) */}
            <div class="z-10 flex flex-col justify-start p-8 pt-3 pb-8 xl:col-span-7 xl:col-start-1 xl:row-start-2 xl:justify-center xl:p-10 xl:pt-3 xl:pb-10">
              <CmsRichText
                value={card.description}
                tag="p"
                className="text-sm leading-relaxed font-medium text-base-content/75 md:text-base"
              />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Extra Architectural Pillars bottom strip -->
    <!-- <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16 border-t border-base-content/15 pt-12">
      <div class="flex gap-4 items-start p-4">
