---
import CurvedLineIcon from './icons/CurvedLineIcon.astro';
import Globe from './Globe.svelte';
import type { FootprintMetric, GlobeMarker } from '~/data/cms';
import CmsRichText from './CmsRichText.astro';

interface Props {
  sectionId?: string;
  heading: string;
  metrics: FootprintMetric[];
  globe: {
    markers: GlobeMarker[];
  };
}

const { sectionId, heading, metrics, globe } = Astro.props;
const globeMarkers = globe.markers.map((marker) => ({
  name: marker.name,
  size: marker.size,
  location: [marker.latitude, marker.longitude] as [number, number],
}));
---

<section id={sectionId} class="relative mx-auto max-w-6xl overflow-hidden px-4 py-24">
  <div
    class="relative isolate mx-4 transform-[translateZ(0)] overflow-visible rounded-3xl border border-primary/20 bg-base-100 px-4 py-20 shadow-sm sm:px-8 lg:mx-0 lg:px-16"
  >
    <!-- Subtle curved top line -->
    <div class="pointer-events-none absolute top-4 right-0 left-0 flex justify-center">
      <CurvedLineIcon class="h-auto w-full max-w-[600px] px-4 sm:px-8 md:px-0" />
    </div>

    <!-- Content Split -->
    <div
      class="relative z-10 flex flex-col items-center justify-between gap-12 md:flex-row md:gap-8"
    >
      <!-- Stats Side -->
      <div class="w-full space-y-12 md:w-1/2">
        <div>
          <h2
            class="mb-10 text-center text-4xl font-bold text-base-content md:text-left md:text-5xl"
          >
            <CmsRichText value={heading} />
          </h2>
        </div>

        <div class="grid gap-10">
          {
            metrics.map((metric) => (
              <div class="text-center md:text-left">
                <div class="flex items-baseline justify-center text-5xl font-light text-primary md:justify-start">
                  <CmsRichText value={metric.value} />
                  {metric.suffix && (
                    <CmsRichText value={metric.suffix} className="ml-1 text-4xl" />
                  )}
                </div>
                <CmsRichText
                  value={metric.label}
                  tag="p"
                  className="mt-1 text-lg text-base-content/70"
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Globe Column (Right Side) -->
      <div class="flex w-full items-center justify-center md:w-1/2">
        <div class="relative aspect-square w-full max-w-[500px] overflow-visible">
          <Globe
            client:visible
            config={{ width: 500, phi: 3.368 }}
            expandable={false}
            className=""
            markers={globeMarkers}
            ariaLabel="Interactive globe showing HTIS office locations"
          />
        </div>
      </div>
    </div>
  </div>
</section>
