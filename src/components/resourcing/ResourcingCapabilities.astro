---
import CmsIcon from '~/components/CmsIcon.astro';
import CmsRichText from '~/components/CmsRichText.astro';

interface CapabilityItem {
  iconName: string;
  title: string;
  desc: string;
  colSpan?: boolean;
}

interface Props {
  capabilities: CapabilityItem[];
}

const { capabilities } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
  {
    capabilities.map((cap) => {
      return (
        <div
          class:list={[
            'flex flex-col items-start gap-4 border border-base-content/20 bg-base-content/5 p-8 shadow-sm backdrop-blur-md transition-colors hover:bg-base-300/60 sm:flex-row sm:gap-5 md:px-6 md:py-4',
            cap.colSpan && 'lg:col-span-2',
          ]}
        >
          <div class="shrink-0 rounded-xl bg-primary/10 p-3 text-primary">
            <CmsIcon name={cap.iconName} className="h-8 w-8" />
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="mb-2 text-2xl font-medium text-base-content">
              <CmsRichText value={cap.title} />
            </h3>
            <p class="text-base leading-relaxed text-base-content">
              <CmsRichText value={cap.desc} />
            </p>
          </div>
        </div>
      );
    })
  }
</div>
