---
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import Contact from '~/components/Contact.astro';
import JobListing from '~/components/jobs/JobListing.svelte';
---

<Layout>
  <div class="relative flex min-h-screen w-full flex-col bg-base-200/30 pt-24 pb-0">
    <Navbar />

    <main class="z-10 mx-auto w-full max-w-5xl grow px-4 py-12 md:px-6 md:py-20">
      <h1 class="mb-12 text-4xl font-bold text-base-content md:text-5xl">
        Find your next<br />Opportunity
      </h1>

      <JobListing client:load />
    </main>

    <div class="mt-auto">
      <div class="pt-16 md:pt-24">
        <Contact />
        <Footer overlap={true} />
      </div>
    </div>
  </div>
</Layout>
